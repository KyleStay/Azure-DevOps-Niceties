{
  "manifest_version": 3,
  "name": "Azure DevOps Niceties",
  "version": "0.6.11",
  "description": "Follow system theme, copy work-item references, summarize estimates, and edit work-item states in Azure DevOps.",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Azure DevOps Niceties",
    "default_popup": "options/options.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ],
      "js": [
        "src/work-item.js",
        "src/theme-settings.js",
        "src/state-client.js",
        "src/state-editor.js",
        "src/content.js",
        "src/selection-summary.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ],
      "js": [
        "src/theme.js",
        "src/state-form.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "111"
}
